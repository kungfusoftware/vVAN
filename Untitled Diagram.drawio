<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36" version="29.5.5">
  <diagram name="Page-1" id="AeNxjhrdsPMwpV47tDYS">
    <mxGraphModel dx="1251" dy="691" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="nPkM5YuVpGYU68A6vW6a-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Edge: Internet facing ingress&lt;/div&gt;&lt;div&gt;reverse proxy layer -- Appache HTTP NgInx, App gateway&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SSL/TLS termination, HTTP compression, Static Content caching, connection rate limitation&lt;/div&gt;&lt;div&gt;WAF, DDOS after the reverse proxy&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="530" x="200" y="190" as="geometry" />
        </mxCell>
        <mxCell id="nPkM5YuVpGYU68A6vW6a-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;technical requirements&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;What are the ingress pattens&lt;/li&gt;&lt;li&gt;what does the east-west traffic look like between services? where are the consumers? geographic distributted client&lt;/li&gt;&lt;li&gt;What are latency SLA?&amp;nbsp;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br style=&quot;text-align: center;&quot;&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="410" x="180" y="40" as="geometry" />
        </mxCell>
        <mxCell id="nPkM5YuVpGYU68A6vW6a-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="API Gateway -- cross cutting concern&lt;div&gt;1. Authentication &amp;amp; Authorization&lt;/div&gt;&lt;div&gt;2. rate limiting&lt;/div&gt;&lt;div&gt;3. request routing, response tranformtion, API versioning,&amp;nbsp;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="520" x="200" y="320" as="geometry" />
        </mxCell>
        <mxCell id="nPkM5YuVpGYU68A6vW6a-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="A &lt;strong&gt;service mesh&lt;/strong&gt; — Istio or Linkerd in environments I&#39;ve worked with — moves all of that into the infrastructure layer via sidecar proxies. The application code makes a plain HTTP call; the sidecar handles mTLS, retries, circuit breaking, load balancing, and telemetry collection transparently. From a middleware architecture perspective, the key design decisions are: what&#39;s the service discovery model, how do you manage certificate rotation at scale, and how do you enforce traffic policies without the mesh becoming a performance bottleneck. I&#39;ve found that keeping the data plane lightweight and the control plane separate is the right architectural principle — the data plane has to be on the hot path for every service call, so latency overhead there is unacceptable." vertex="1">
          <mxGeometry height="150" width="520" x="200" y="470" as="geometry" />
        </mxCell>
        <mxCell id="nPkM5YuVpGYU68A6vW6a-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;font-claude-response-body break-words whitespace-normal leading-[1.7]&quot;&gt; &lt;strong&gt;Apache Kafka&lt;/strong&gt; as the event streaming backbone at TransUnion for the Marketing Solutions domain — handling high-volume data flows across 30-plus technology platforms — and at NPD for the Big Data pipeline migration (Event Grid)&lt;/p&gt;&lt;p class=&quot;font-claude-response-body break-words whitespace-normal leading-[1.7]&quot;&gt;The middleware architecture decisions around Kafka that matter at global scale are: partitioning strategy — because your partition key determines both parallelism and ordering guarantees; replication factor across geographic regions — because you need durability without sacrificing write latency; and consumer group design — because how you structure consumers determines whether you get the independent scalability benefit or accidentally recreate a synchronous bottleneck with extra steps.&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="520" x="200" y="670" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
